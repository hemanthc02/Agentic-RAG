# ai-service configuration (copy to .env; never commit real keys)
LLM_MODE=cloud                 # cloud | local
LLM_PROVIDER=gemini            # gemini | openrouter | nvidia_nim | ollama

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

REQUEST_TIMEOUT_S=60
MAX_ATTEMPTS=3
