# Environment template — copy to .env and fill in. Never commit real values.
# This reflects what the running app actually reads (research pipeline + app/ prototype).

# --- LLM: exactly two models ---
# cloud → Groq (Llama 4 Scout 17B);  local → Ollama (Phi-3 mini, auto-detected).
LLM_MODE=cloud
LLM_PROVIDER=groq
GROQ_API_KEY=                                   # required for cloud mode (free tier OK)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- Auth (app/backend) ---
# Required in production/staging; dev falls back to an insecure key with a warning.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900

# --- Web (frontend) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- FUTURE (production SaaS monorepo only — NOT used by the current app/ prototype,
#     which persists to SQLite). Uncomment when apps/api lands. ---
# DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas
# REDIS_URL=redis://localhost:6379/0
# POSTGRES_PASSWORD=veritas
