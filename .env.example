# Environment template — copy to .env and fill in. Never commit real values.
# This reflects what the running app actually reads (research pipeline + app/ prototype).

# --- LLM ---
# Online (cloud): choose ONE provider below via LLM_PROVIDER.
#   anthropic -> Claude   |   groq -> Llama
# Offline (local): Ollama (phi4-mini), used automatically when the app is set to Offline.
LLM_MODE=cloud
LLM_PROVIDER=anthropic

# Online option A: Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=                              # required if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5

# Online option B: Groq Llama — https://console.groq.com
GROQ_API_KEY=                                   # required if LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Offline (local) model via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# --- Auth (app/backend) ---
# A random secret is generated automatically on first run if left blank.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=28800

# --- Web (frontend) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- FUTURE (production SaaS monorepo only — NOT used by the current app/ prototype,
#     which persists to SQLite). Uncomment when apps/api lands. ---
# DATABASE_URL=postgresql+asyncpg://veritas:veritas@localhost:5432/veritas
# REDIS_URL=redis://localhost:6379/0
# POSTGRES_PASSWORD=veritas
